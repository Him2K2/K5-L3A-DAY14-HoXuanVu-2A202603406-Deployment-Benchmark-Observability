# ============================================================
# Biến môi trường app cần (tiêu chí 9). KHÔNG ghi secret thật ở đây.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Security — bắt buộc cấp key thật qua env / platform, KHÔNG commit key thật.
AGENT_API_KEY=change-me-in-production

# Redis (dùng cho rate limit + cost guard)
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Cost guard (đặt ít nhất một trong hai)
DAILY_BUDGET_USD=10
MONTHLY_BUDGET_USD=0
